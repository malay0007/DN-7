
@model FeedbackManagement.Models.Feedback

@{
    ViewBag.Title = "Feedback Management";
}

<!DOCTYPE html>
<html>
<head>
    <title>Feedback Management</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #eef2f7;
            font-family: Arial, sans-serif;
        }

        .feedback-box {
            max-width: 650px;
            margin: 40px auto;
            padding: 30px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px #ccc;
        }

        h2 {
            color: #173b70;
            text-align: center;
            margin-bottom: 25px;
        }

        .field {
            margin-bottom: 18px;
        }

        .error {
            color: red;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="feedback-box">
            <h2>Feedback Management</h2>

            @if (ViewBag.Submitted != null)
            {
                <div class="alert alert-success">
                    Feedback submitted successfully!
                </div>

                <p><b>Name:</b> @ViewBag.Name</p>
                <p><b>Email:</b> @ViewBag.Email</p>
                <p><b>Category:</b> @ViewBag.Category</p>
                <p><b>Rating:</b> @ViewBag.Rating / 5</p>
                <p><b>Comments:</b> @ViewBag.Comments</p>

                @Html.ActionLink("Submit Another Feedback", "Index",
                    "Feedback", null, new { @class = "btn btn-primary" })
            }
            else
            {
                using (Html.BeginForm("Index", "Feedback", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="field">
                        @Html.LabelFor(m => m.Name)
                        @Html.TextBoxFor(m => m.Name,
                            new { @class = "form-control", placeholder = "Enter your name" })
                        @Html.ValidationMessageFor(m => m.Name, "",
                            new { @class = "error" })
                    </div>

                    <div class="field">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email,
                            new { @class = "form-control", placeholder = "Enter email", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "",
                            new { @class = "error" })
                    </div>

                    <div class="field">
                        @Html.LabelFor(m => m.Category)
                        @Html.DropDownListFor(m => m.Category,
                            new SelectList(new[] { "Website", "Service", "Product", "Other" }),
                            "-- Select Category --",
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Category, "",
                            new { @class = "error" })
                    </div>

                    <div class="field">
                        @Html.LabelFor(m => m.Rating)
                        @Html.DropDownListFor(m => m.Rating,
                            new SelectList(new[] { 1, 2, 3, 4, 5 }, Model.Rating),
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Rating, "",
                            new { @class = "error" })
                    </div>

                    <div class="field">
                        @Html.LabelFor(m => m.Comments)
                        @Html.TextAreaFor(m => m.Comments, 4, 40,
                            new { @class = "form-control", placeholder = "Enter your feedback" })
                        @Html.ValidationMessageFor(m => m.Comments, "",
                            new { @class = "error" })
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Submit Feedback
                    </button>
                }
            }
        </div>
    </div>
</body>
</html>
